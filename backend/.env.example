# Copy to .env and adjust for your machine. Never commit the real .env.

# --- PostgreSQL ---
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_PORT=5432
MASTER_DB=erp_master_db
TENANT_TEMPLATE_DB=erp_tenant_template_db

# --- Redis ---
REDIS_PASSWORD=erp_dev_password
REDIS_PORT=6379

# --- tenants backend (src/main.rs / platform::db) ---
# Used when running the backend directly with `cargo run` against
# the compose stack's Postgres/Redis on localhost. Must match the
# Postgres/Redis credentials above.
DATABASE_URL=postgres://erp_admin:erp_dev_password@localhost:5432/erp_master_db
REDIS_URL=redis://:erp_dev_password@localhost:6379
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# --- app container (compose.yaml's `app` service only) ---
# Host port the bundled frontend+backend image is published on; the
# `app` service builds its own DATABASE_URL/REDIS_URL pointed at the
# `postgres`/`redis` service hostnames, so those two vars above don't
# apply to it.
APP_PORT=8080
