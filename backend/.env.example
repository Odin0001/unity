# Copy to .env and adjust for your machine. Never commit the real .env.

# --- PostgreSQL ---
POSTGRES_USER=debt_admin
POSTGRES_PASSWORD=debt_dev_password
POSTGRES_DB=debt_collection
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=debt_dev_password
REDIS_PORT=6379

# --- backend (`cargo run`) ---
# Used when running the backend directly against the compose stack's
# Postgres/Redis on localhost. Must match the credentials above.
DATABASE_URL=postgres://debt_admin:debt_dev_password@localhost:5432/debt_collection
REDIS_URL=redis://:debt_dev_password@localhost:6379
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# --- Platform admin link ---
# This deployment authenticates to the admin service with the API key
# returned once by `POST /api/v1/tenants` on the admin side.
ADMIN_API_URL=http://localhost:8081
TENANT_API_KEY=

# --- Executive manager ---
# The tenant's first employee, created on startup while there are no
# employees yet. They get full access to everything and set every other
# employee's permissions. Password must be at least 12 characters.
EXECUTIVE_MANAGER_EMAIL=boss@tenant.local
EXECUTIVE_MANAGER_PASSWORD=change-me-please
EXECUTIVE_MANAGER_NAME="Executive Manager"

# --- app container (compose.yaml's `app` service only) ---
# Host port the bundled image is published on. The `app` service builds
# its own DATABASE_URL/REDIS_URL pointing at the `postgres`/`redis`
# service hostnames, so the two URLs above don't apply to it.
APP_PORT=8080
